# Copy to .env.local for local overrides, or set these in the Vercel project's
# Environment Variables screen.
#
# Leave VITE_API_BASE_URL unset (or empty) for `npm run dev` and for docker compose: both put
# the API on the same origin as the app, so relative /api requests already work.
#
# Set it to the deployed API's origin — no trailing slash — when the frontend is hosted
# separately, which is exactly the Vercel + Render split:
# VITE_API_BASE_URL=https://zegin-health-hub-api.onrender.com
VITE_API_BASE_URL=
