# Copy to .env (git-ignored) and adjust. Every value has a working default in
# docker-compose.yml, so `docker compose up --build` works with no .env at all — this file is
# for overriding ports that collide and for setting a real maintenance token.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=zegin
POSTGRES_PASSWORD=zegin_dev_password
POSTGRES_DB=zeginhealthhub
POSTGRES_PORT=5432

# --- Published ports ------------------------------------------------------
WEB_PORT=8080
API_PORT=5159

# --- API ------------------------------------------------------------------
# Comma-separated. A single leading wildcard label is allowed, e.g. https://*.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Shared secret for POST /api/maintenance/cleanup and /ping. Generate a real one with:
#   openssl rand -hex 32
MAINTENANCE_TOKEN=local-dev-maintenance-token

# How long anonymous page-view rows are kept before the cleanup job deletes them.
ANALYTICS_RETENTION_DAYS=90

# How often the optional `cron` compose profile runs the cleanup (86400 = daily).
CLEANUP_INTERVAL_SECONDS=86400
